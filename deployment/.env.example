# Generate deployment/.env with Manage-QStudy.sh init; never commit that file.
# Keep values single-quoted so SMTP passwords containing $ are not expanded.
QSTUDY_DOMAIN='qstudy.example.org'
ACME_EMAIL='owner@example.org'
PUBLIC_BASE_URL='https://qstudy.example.org'
SECRET_KEY=''
BFF_PROXY_SECRET=''
REGISTRATION_ENABLED='true'
RATE_LIMIT_ENABLED='true'
BACKUPS_ENABLED='true'
BACKUP_INTERVAL_HOURS='24'
BACKUP_RETENTION_COUNT='14'
GEMINI_API_KEY=''
GEMINI_MODEL='gemini-3.6-flash'
WEB_RESEARCH_ENABLED='true'
GEMINI_WEB_MODEL=''
# Use smtp after entering all SMTP fields; local recovery is disabled on a host.
RECOVERY_DELIVERY='disabled'
PASSWORD_RESET_MINUTES='30'
SMTP_HOST=''
SMTP_PORT='587'
SMTP_USERNAME=''
SMTP_PASSWORD=''
SMTP_FROM=''
SMTP_SECURITY='starttls'
