# Generate a private secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
DATABASE_URL=sqlite:///./studyhub.db
UPLOAD_DIR=./uploads
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Public-topic Google Search grounding through the same Gemini key.
# Empty WEB model follows GEMINI_MODEL; requires a Search-capable Gemini model.
# Search quota/pricing is separate from ordinary generation. No private context is searched.
WEB_RESEARCH_ENABLED=true
GEMINI_WEB_MODEL=
WEB_RESEARCH_TIMEOUT_SECONDS=35
WEB_RESEARCH_MAX_SOURCES=8
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_BYTES=26214400
REGISTRATION_ENABLED=true
RATE_LIMIT_ENABLED=true
BACKUPS_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# Relative to the project root; leave unset to use .backups/automatic.
# BACKUP_DIR=.backups/automatic
JOB_WORKERS=2
JOB_LEASE_SECONDS=90
JOB_MAX_ATTEMPTS=3
PUBLIC_BASE_URL=http://127.0.0.1:3000
# auto uses SMTP when configured, otherwise a private local recovery file.
# Public hosting requires smtp and an HTTPS PUBLIC_BASE_URL.
RECOVERY_DELIVERY=auto
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
